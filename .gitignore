# Environment variables and secrets
.env
.env.*
*.env
credentials.json
secrets.json
token.json
service-account.json
client_secret.json
*.pem
*.key
*.p12
*.pfx

# API keys or local config
config.local.*
*.local

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo

# Claude Code local settings (contains personal hooks/config, must not be committed)
.claude/settings.local.json

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp

# Node / package files - not used in this repository, but ignored for safety
node_modules/
package-lock.json
pnpm-lock.yaml
yarn.lock

# Python cache - not used in this repository, but ignored for safety
__pycache__/
*.pyc
.venv/
venv/

# Build outputs - not used in this repository, but ignored for safety
dist/
build/

# Generated archives
*.zip
*.tar
*.gz
